# -------------------------------------------------------------
# SUPABASE CONFIGURATION (Prisma + Supabase PostgreSQL)
# -------------------------------------------------------------
# Transaction mode (port 6543) with PgBouncer / Supavisor for connection pooling
DATABASE_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[YOUR-REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"

# Direct session connection (port 5432) used for migrations and prisma db push
DIRECT_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[YOUR-REGION].pooler.supabase.com:5432/postgres"

# -------------------------------------------------------------
# SUPABASE CLIENT API (For Supabase Storage & Client SDK)
# -------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL="https://[YOUR-PROJECT-REF].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-key"

# -------------------------------------------------------------
# APP SECURITY SECRETS
# -------------------------------------------------------------
SERVER_SECRET_SALT="aejaz-training-secure-salt-2026"
NEXT_PUBLIC_APP_URL="https://www.aejaz.in"
